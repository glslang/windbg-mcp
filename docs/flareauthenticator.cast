[0,"o","\u001b[1mFlareAuthenticator (Flare-On 12 #8) — solved with windbg-mcp TTD + Z3\r\n\u001b[0m"]
[0.4,"o","\u001b[90m# A Qt keypad wants a 25-digit code. No cleartext strings; heavy obfuscation.\u001b[0m\r\n"]
