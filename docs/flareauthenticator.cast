[11.614,"o","\u001b[90m# ttd_memory shows the hash slot is written 25 times — once per keystroke.\u001b[0m\r\n"]
[11.664,"o","\u001b[90m# Disassembling the update, the obfuscated bit-ops collapse to a pure sum:\u001b[0m\r\n"]
[11.714,"o","\r\n"]
[11.714,"o","\u001b[1;35m   hash = Σ  Y[i] * g( (i+1)*256 + '0' + d[i] )   ≡  0x0bc42d5779fec401   (mod 2^64)\u001b[0m\r\n"]
[11.754,"o","\r\n"]
[12.354,"o","\u001b[90m# A live test proves g ignores the running hash — so it is a clean pure sum,\u001b[0m\r\n"]
[12.404,"o","\u001b[90m# and each digit contributes independently. That is an SMT problem.\u001b[0m\r\n"]
[12.454,"o","\r\n"]
